### 4.8 关于我们页 (about.plush.html)

```html
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <title>关于我们 - <%= site['title'] %></title>
  <%= partial("head.html") { %>
    <meta name="description" content="了解速达物流的发展历程、企业文化、核心优势">
  <% } %>
</head>
<body>
  <%= partial("header.html") {} %>
  
  <%= partial("banner.html") {
    bannerTitle: "关于我们",
    bannerSubtitle: "专业物流服务商，值得信赖的合作伙伴",
    bannerImage: asset_path("images/banner-about.jpg"),
    breadcrumbs: [
      { Label: "关于我们" }
    ]
  } %>
  
  <main class="about-page">
    <!-- 公司简介 -->
    <section class="about-intro section-padding">
      <div class="container">
        <div class="intro-layout">
          <div class="intro-image">
            <img src="<%= asset_path('images/about-building.jpg') %>" alt="速达物流">
          </div>
          <div class="intro-content">
            <span class="section-tag">公司简介</span>
            <h2 class="section-title">致力于成为<br>最值得信赖的物流合作伙伴</h2>
            <p>速达物流成立于2009年，是一家专业的综合物流服务提供商。经过15年的发展，我们已建立起覆盖全国300+城市的物流网络，拥有5000+运输车辆、200+仓储中心，日均处理订单超过100万单。</p>
            <p>我们始终秉承"客户至上、服务第一"的经营理念，致力于为客户提供安全、高效、便捷的物流解决方案。无论是快递、货运、仓储还是冷链物流，我们都能为您提供专业的服务。</p>
            <div class="intro-stats">
              <div class="stat">
                <span class="stat-number">15+</span>
                <span class="stat-label">年行业经验</span>
              </div>
              <div class="stat">
                <span class="stat-number">300+</span>
                <span class="stat-label">覆盖城市</span>
              </div>
              <div class="stat">
                <span class="stat-number">5000+</span>
                <span class="stat-label">企业客户</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- 企业文化 -->
    <section class="about-culture section-padding bg-light">
      <div class="container">
        <div class="section-header text-center">
          <h2 class="section-title">企业文化</h2>
          <p class="section-subtitle">我们的核心价值观</p>
        </div>
        
        <div class="culture-grid">
          <div class="culture-item">
            <div class="culture-icon">
              <img src="<%= asset_path('images/icons/icon-mission.svg') %>" alt="使命">
            </div>
            <h3>企业使命</h3>
            <p>让物流更简单，让商业更高效</p>
          </div>
          <div class="culture-item">
            <div class="culture-icon">
              <img src="<%= asset_path('images/icons/icon-vision.svg') %>" alt="愿景">
            </div>
            <h3>企业愿景</h3>
            <p>成为最值得信赖的综合物流服务提供商</p>
          </div>
          <div class="culture-item">
            <div class="culture-icon">
              <img src="<%= asset_path('images/icons/icon-values.svg') %>" alt="价值观">
            </div>
            <h3>核心价值观</h3>
            <p>客户至上、诚信为本、创新进取、合作共赢</p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- 发展历程 -->
    <section class="about-history section-padding">
      <div class="container">
        <div class="section-header text-center">
          <h2 class="section-title">发展历程</h2>
          <p class="section-subtitle">砥砺前行，不断超越</p>
        </div>
        
        <div class="timeline">
          <%= for (event, index) in historyEvents { %>
          <div class="timeline-item <%= if (index % 2 == 0) { 'left' } else { 'right' } %>">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-year"><%= event.Year %></span>
              <h4><%= event.Title %></h4>
              <p><%= event.Description %></p>
            </div>
          </div>
          <%= } %>
        </div>
      </div>
    </section>
    
    <!-- 核心优势 -->
    <section class="about-advantages section-padding bg-primary">
      <div class="container">
        <div class="section-header text-center">
          <h2 class="section-title text-white">核心优势</h2>
          <p class="section-subtitle text-gray">为什么选择速达物流</p>
        </div>
        
        <div class="advantages-grid">
          <div class="advantage-item">
            <div class="advantage-number">01</div>
            <h3>网络覆盖广</h3>
            <p>覆盖全国300+城市，县级以上城市全覆盖，乡镇配送网络完善</p>
          </div>
          <div class="advantage-item">
            <div class="advantage-number">02</div>
            <h3>运力资源足</h3>
            <p>5000+自有车辆，多种车型可选，满足各类运输需求</p>
          </div>
          <div class="advantage-item">
            <div class="advantage-number">03</div>
            <h3>信息化程度高</h3>
            <p>全程GPS跟踪，实时查询货物位置，智能调度系统</p>
          </div>
          <div class="advantage-item">
            <div class="advantage-number">04</div>
            <h3>服务品质优</h3>
            <p>专业客服团队，7×24小时服务，时效承诺，超时赔付</p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- 资质荣誉 -->
    <section class="about-honors section-padding">
      <div class="container">
        <div class="section-header text-center">
          <h2 class="section-title">资质荣誉</h2>
          <p class="section-subtitle">权威认证，值得信赖</p>
        </div>
        
        <div class="honors-grid">
          <%= for (honor) in honors { %>
          <div class="honor-item">
            <img src="<%= honor.Image %>" alt="<%= honor.Name %>">
            <p><%= honor.Name %></p>
          </div>
          <%= } %>
        </div>
      </div>
    </section>
  </main>
  
  <%= partial("footer.html") {} %>
  <%= partial("scripts.html") {} %>
</body>
</html>
```


### 4.3 服务项目列表页 (services.plush.html)

```html
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <title>服务项目 - <%= site['title'] %></title>
  <%= partial("head.html") { %>
    <meta name="description" content="速达物流提供快递、货运、仓储、冷链等全方位物流服务">
  <% } %>
</head>
<body>
  <%= partial("header.html") {} %>
  
  <%= partial("banner.html") {
    bannerTitle: "服务项目",
    bannerSubtitle: "全方位物流解决方案，满足您的各种需求",
    bannerImage: asset_path("images/banner-services.jpg"),
    breadcrumbs: [
      { Label: "服务项目" }
    ]
  } %>
  
  <main class="services-page">
    <section class="section-padding">
      <div class="container">
        <!-- 服务分类筛选 -->
        <div class="services-filter">
          <button class="filter-btn active" data-filter="all">全部服务</button>
          <button class="filter-btn" data-filter="express">快递服务</button>
          <button class="filter-btn" data-filter="freight">货运服务</button>
          <button class="filter-btn" data-filter="warehouse">仓储服务</button>
          <button class="filter-btn" data-filter="coldchain">冷链物流</button>
        </div>
        
        <!-- 服务列表 -->
        <div class="services-list">
          <%= for (service) in services { %>
          <div class="service-item" data-category="<%= service.Category %>">
            <div class="service-image">
              <img src="<%= service.Image || asset_path('images/service-default.jpg') %>" alt="<%= service.Title %>">
            </div>
            <div class="service-info">
              <span class="service-category"><%= service.CategoryName %></span>
              <h2><%= service.Title %></h2>
              <p class="service-desc"><%= service.Description %></p>
              <ul class="service-features">
                <%= for (feature) in service.Features { %>
                  <li><i class="icon-check"></i> <%= feature %></li>
                <%= } %>
              </ul>
              <div class="service-actions">
                <a href="/service/<%= service.Slug %>" class="btn btn-primary">了解详情</a>
                <a href="/contact?service=<%= service.Slug %>" class="btn btn-outline">立即咨询</a>
              </div>
            </div>
          </div>
          <%= } %>
        </div>
      </div>
    </section>
    
    <!-- 服务流程 -->
    <section class="process-section section-padding bg-light">
      <div class="container">
        <div class="section-header text-center">
          <h2 class="section-title">服务流程</h2>
          <p class="section-subtitle">简单四步，轻松发货</p>
        </div>
        
        <div class="process-steps">
          <div class="process-step">
            <div class="step-number">01</div>
            <div class="step-icon">
              <img src="<%= asset_path('images/icons/icon-consult.svg') %>" alt="咨询">
            </div>
            <h3>在线咨询</h3>
            <p>联系客服，告知运输需求</p>
          </div>
          <div class="process-arrow">→</div>
          <div class="process-step">
            <div class="step-number">02</div>
            <div class="step-icon">
              <img src="<%= asset_path('images/icons/icon-quote.svg') %>" alt="报价">
            </div>
            <h3>获取报价</h3>
            <p>专业团队为您制定方案</p>
          </div>
          <div class="process-arrow">→</div>
          <div class="process-step">
            <div class="step-number">03</div>
            <div class="step-icon">
              <img src="<%= asset_path('images/icons/icon-pickup.svg') %>" alt="取件">
            </div>
            <h3>上门取件</h3>
            <p>预约时间，上门取货</p>
          </div>
          <div class="process-arrow">→</div>
          <div class="process-step">
            <div class="step-number">04</div>
            <div class="step-icon">
              <img src="<%= asset_path('images/icons/icon-delivery.svg') %>" alt="送达">
            </div>
            <h3>安全送达</h3>
            <p>全程跟踪，准时送达</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <%= partial("footer.html") {} %>
  <%= partial("scripts.html") {} %>
</body>
</html>
```

---

### 4.4 服务详情页 (service_detail.plush.html)

```html
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <title><%= service.Title %> - <%= site['title'] %></title>
  <%= partial("head.html") { %>
    <meta name="description" content="<%= service.Summary %>">
  <% } %>
</head>
<body>
  <%= partial("header.html") {} %>
  
  <%= partial("banner.html") {
    bannerTitle: service.Title,
    bannerSubtitle: service.Summary,
    bannerImage: service.BannerImage || asset_path("images/banner-services.jpg"),
    breadcrumbs: [
      { Label: "服务项目", URL: "/services" },
      { Label: service.Title }
    ]
  } %>
  
  <main class="service-detail-page">
    <div class="container">
      <div class="detail-layout">
        <!-- 主内容 -->
        <article class="detail-main">
          <div class="service-content">
            <%= service.ContentHTML %>
          </div>
          
          <!-- 服务优势 -->
          <%= if (service.Advantages && len(service.Advantages) > 0) { %>
          <div class="service-advantages">
            <h2>服务优势</h2>
            <div class="advantages-grid">
              <%= for (adv) in service.Advantages { %>
              <div class="advantage-item">
                <i class="icon-check-circle"></i>
                <h4><%= adv.Title %></h4>
                <p><%= adv.Description %></p>
              </div>
              <%= } %>
            </div>
          </div>
          <%= } %>
          
          <!-- 应用场景 -->
          <%= if (service.Scenarios && len(service.Scenarios) > 0) { %>
          <div class="service-scenarios">
            <h2>适用场景</h2>
            <div class="scenarios-list">
              <%= for (scenario) in service.Scenarios { %>
              <div class="scenario-item">
                <img src="<%= scenario.Image %>" alt="<%= scenario.Title %>">
                <h4><%= scenario.Title %></h4>
                <p><%= scenario.Description %></p>
              </div>
              <%= } %>
            </div>
          </div>
          <%= } %>
          
          <!-- CTA -->
          <div class="service-cta">
            <h3>需要<%= service.Title %>？</h3>
            <p>立即联系我们，获取专属方案和报价</p>
            <a href="/contact?service=<%= service.Slug %>" class="btn btn-lg btn-primary">立即咨询</a>
          </div>
        </article>
        
        <!-- 侧边栏 -->
        <aside class="detail-sidebar">
          <!-- 快速联系 -->
          <div class="sidebar-widget contact-widget">
            <h4>快速咨询</h4>
            <p class="phone"><%= config['contact.phone'] || '400-888-8888' %></p>
            <a href="tel:<%= config['contact.phone'] || '400-888-8888' %>" class="btn btn-primary btn-block">立即拨打</a>
          </div>
          
          <!-- 其他服务 -->
          <div class="sidebar-widget services-widget">
            <h4>其他服务</h4>
            <ul>
              <%= for (s) in otherServices { %>
                <li><a href="/service/<%= s.Slug %>"><%= s.Title %></a></li>
              <%= } %>
            </ul>
          </div>
          
          <!-- 下载资料 -->
          <%= if (service.Downloads && len(service.Downloads) > 0) { %>
          <div class="sidebar-widget downloads-widget">
            <h4>相关资料</h4>
            <ul>
              <%= for (file) in service.Downloads { %>
                <li>
                  <a href="<%= file.URL %>" download>
                    <i class="icon-download"></i>
                    <%= file.Name %>
                  </a>
                </li>
              <%= } %>
            </ul>
          </div>
          <%= } %>
        </aside>
      </div>
    </div>
  </main>
  
  <%= partial("footer.html") {} %>
  <%= partial("scripts.html") {} %>
</body>
</html>
```

---

### 4.5 行业新闻列表页 (news.plush.html)

```html
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <title>行业新闻 - <%= site['title'] %></title>
  <%= partial("head.html") { %>
    <meta name="description" content="了解物流行业最新资讯、公司动态">
  <% } %>
</head>
<body>
  <%= partial("header.html") {} %>
  
  <%= partial("banner.html") {
    bannerTitle: "行业新闻",
    bannerSubtitle: "了解物流行业最新资讯与公司动态",
    bannerImage: asset_path("images/banner-news.jpg"),
    breadcrumbs: [
      { Label: "行业新闻" }
    ]
  } %>
  
  <main class="news-page">
    <section class="section-padding">
      <div class="container">
        <div class="news-layout">
          <!-- 新闻列表 -->
          <div class="news-main">
            <%= if (featuredNews) { %>
            <!-- 头条新闻 -->
            <article class="news-featured">
              <div class="featured-image">
                <img src="<%= featuredNews.Thumbnail || asset_path('images/news-default.jpg') %>" alt="<%= featuredNews.Title %>">
              </div>
              <div class="featured-content">
                <span class="news-category"><%= featuredNews.Category.Name %></span>
                <h2><a href="/news/<%= featuredNews.Slug %>"><%= featuredNews.Title %></a></h2>
                <p><%= featuredNews.Excerpt %></p>
                <div class="news-meta">
                  <span><i class="icon-calendar"></i> <%= format_date(featuredNews.PublishedAt, '2006-01-02') %></span>
                  <span><i class="icon-eye"></i> <%= featuredNews.Views %> 阅读</span>
                </div>
              </div>
            </article>
            <%= } %>
            
            <!-- 新闻网格 -->
            <div class="news-list">
              <%= for (item) in news { %>
              <article class="news-item">
                <div class="news-image">
                  <img src="<%= item.Thumbnail || asset_path('images/news-default.jpg') %>" alt="<%= item.Title %>">
                </div>
                <div class="news-body">
                  <span class="news-category"><%= item.Category.Name %></span>
                  <h3><a href="/news/<%= item.Slug %>"><%= item.Title %></a></h3>
                  <p><%= item.Excerpt %></p>
                  <div class="news-meta">
                    <span><i class="icon-calendar"></i> <%= format_date(item.PublishedAt, '2006-01-02') %></span>
                    <a href="/news/<%= item.Slug %>" class="read-more">阅读全文 →</a>
                  </div>
                </div>
              </article>
              <%= } %>
            </div>
            
            <!-- 分页 -->
            <%= if (pagination.TotalPages > 1) { %>
            <nav class="pagination">
              <%= if (pagination.HasPrev) { %>
                <a href="<%= pagination.PrevURL %>" class="page-prev">← 上一页</a>
              <%= } %>
              
              <%= for (page) in pagination.Pages { %>
                <%= if (page.IsCurrent) { %>
                  <span class="page-current"><%= page.Number %></span>
                <%= } else if (page.IsEllipsis) { %>
                  <span class="page-ellipsis">...</span>
                <%= } else { %>
                  <a href="<%= page.URL %>" class="page-link"><%= page.Number %></a>
                <%= } %>
              <%= } %>
              
              <%= if (pagination.HasNext) { %>
                <a href="<%= pagination.NextURL %>" class="page-next">下一页 →</a>
              <%= } %>
            </nav>
            <%= } %>
          </div>
          
          <!-- 侧边栏 -->
          <aside class="news-sidebar">
            <!-- 搜索 -->
            <div class="sidebar-widget">
              <h4>搜索新闻</h4>
              <form action="/news" method="get" class="search-form">
                <input type="text" name="q" placeholder="输入关键词..." value="<%= searchQuery %>">
                <button type="submit"><i class="icon-search"></i></button>
              </form>
            </div>
            
            <!-- 分类 -->
            <div class="sidebar-widget">
              <h4>新闻分类</h4>
              <ul class="category-list">
                <%= for (cat) in newsCategories { %>
                  <li class="<%= if (currentCategory == cat.Slug) { 'active' } %>">
                    <a href="/news?category=<%= cat.Slug %>">
                      <%= cat.Name %>
                      <span class="count">(<%= cat.PostCount %>)</span>
                    </a>
                  </li>
                <%= } %>
              </ul>
            </div>
            
            <!-- 热门新闻 -->
            <div class="sidebar-widget">
              <h4>热门新闻</h4>
              <ul class="hot-news-list">
                <%= for (item) in hotNews { %>
                  <li>
                    <a href="/news/<%= item.Slug %>">
                      <span class="number"><%= index + 1 %></span>
                      <span class="title"><%= item.Title %></span>
                    </a>
                  </li>
                <%= } %>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
  
  <%= partial("footer.html") {} %>
  <%= partial("scripts.html") {} %>
</body>
</html>
```

---

### 4.6 运力展示页 (fleet.plush.html)

```html
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <title>运力展示 - <%= site['title'] %></title>
  <%= partial("head.html") { %>
    <meta name="description" content="速达物流拥有强大的运输能力，覆盖全国的物流网络">
  <% } %>
</head>
<body>
  <%= partial("header.html") {} %>
  
  <%= partial("banner.html") {
    bannerTitle: "运力展示",
    bannerSubtitle: "强大的运输能力，覆盖全国的物流网络",
    bannerImage: asset_path("images/banner-fleet.jpg"),
    breadcrumbs: [
      { Label: "运力展示" }
    ]
  } %>
  
  <main class="fleet-page">
    <!-- 运力概览 -->
    <section class="fleet-overview section-padding">
      <div class="container">
        <div class="overview-grid">
          <div class="overview-item">
            <div class="overview-icon">
              <img src="<%= asset_path('images/icons/icon-truck.svg') %>" alt="卡车">
            </div>
            <div class="overview-number">5000+</div>
            <div class="overview-label">自有车辆</div>
          </div>
          <div class="overview-item">
            <div class="overview-icon">
              <img src="<%= asset_path('images/icons/icon-warehouse.svg') %>" alt="仓库">
            </div>
            <div class="overview-number">200+</div>
            <div class="overview-label">仓储中心</div>
          </div>
          <div class="overview-item">
            <div class="overview-icon">
              <img src="<%= asset_path('images/icons/icon-route.svg') %>" alt="线路">
            </div>
            <div class="overview-number">3000+</div>
            <div class="overview-label">运输线路</div>
          </div>
          <div class="overview-item">
            <div class="overview-icon">
              <img src="<%= asset_path('images/icons/icon-worker.svg') %>" alt="员工">
            </div>
            <div class="overview-number">8000+</div>
            <div class="overview-label">专业司机</div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- 车辆展示 -->
    <section class="fleet-vehicles section-padding bg-light">
      <div class="container">
        <div class="section-header text-center">
          <h2 class="section-title">运输车队</h2>
          <p class="section-subtitle">多样化车型，满足不同运输需求</p>
        </div>
        
        <div class="vehicles-grid">
          <%= for (vehicle) in fleetVehicles { %>
          <div class="vehicle-card">
            <div class="vehicle-image">
              <img src="<%= vehicle.Image %>" alt="<%= vehicle.Name %>">
            </div>
            <div class="vehicle-info">
              <h3><%= vehicle.Name %></h3>
              <ul class="vehicle-specs">
                <%= for (spec) in vehicle.Specs { %>
                  <li><span class="spec-label"><%= spec.Label %>：</span><span class="spec-value"><%= spec.Value %></span></li>
                <%= } %>
              </ul>
              <p class="vehicle-desc"><%= vehicle.Description %></p>
            </div>
          </div>
          <%= } %>
        </div>
      </div>
    </section>
    
    <!-- 网络覆盖 -->
    <section class="fleet-network section-padding">
      <div class="container">
        <div class="network-content">
          <div class="network-text">
            <h2 class="section-title">全国网络覆盖</h2>
            <p class="section-desc">我们的物流网络覆盖全国300+城市，实现县级以上城市全覆盖，为您提供便捷、高效的物流服务。</p>
            <ul class="network-features">
              <li><i class="icon-check"></i> 省会城市24小时直达</li>
              <li><i class="icon-check"></i> 地级市48小时送达</li>
              <li><i class="icon-check"></i> 县级城市72小时覆盖</li>
              <li><i class="icon-check"></i> 乡镇配送网络完善</li>
            </ul>
          </div>
          <div class="network-map">
            <img src="<%= asset_path('images/network-map.png') %>" alt="全国网络覆盖">
          </div>
        </div>
      </div>
    </section>
    
    <!-- 仓储设施 -->
    <section class="fleet-warehouse section-padding bg-dark">
      <div class="container">
        <div class="section-header text-center">
          <h2 class="section-title text-white">仓储设施</h2>
          <p class="section-subtitle text-gray">现代化仓储，智能化管理</p>
        </div>
        
        <div class="warehouse-grid">
          <div class="warehouse-item">
            <div class="warehouse-image">
              <img src="<%= asset_path('images/warehouse-1.jpg') %>" alt="智能仓储">
            </div>
            <div class="warehouse-info">
              <h3>智能仓储中心</h3>
              <p>采用WMS仓储管理系统，实现货物精准定位、智能分拣</p>
            </div>
          </div>
          <div class="warehouse-item">
            <div class="warehouse-image">
              <img src="<%= asset_path('images/warehouse-2.jpg') %>" alt="冷链仓储">
            </div>
            <div class="warehouse-info">
              <h3>冷链仓储</h3>
              <p>专业冷链仓储设施，温度精准控制，保障生鲜品质</p>
            </div>
          </div>
          <div class="warehouse-item">
            <div class="warehouse-image">
              <img src="<%= asset_path('images/warehouse-3.jpg') %>" alt="危险品仓储">
            </div>
            <div class="warehouse-info">
              <h3>危险品仓储</h3>
              <p>具备危险品仓储资质，专业安全管理，合规运营</p>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- 合作伙伴 -->
    <section class="fleet-partners section-padding">
      <div class="container">
        <div class="section-header text-center">
          <h2 class="section-title">合作伙伴</h2>
          <p class="section-subtitle">携手行业领先企业，共建物流生态</p>
        </div>
        
        <div class="partners-grid">
          <%= for (partner) in partners { %>
            <div class="partner-logo">
              <img src="<%= partner.Logo %>" alt="<%= partner.Name %>">
            </div>
          <%= } %>
        </div>
      </div>
    </section>
  </main>
  
  <%= partial("footer.html") {} %>
  <%= partial("scripts.html") {} %>
</body>
</html>
```


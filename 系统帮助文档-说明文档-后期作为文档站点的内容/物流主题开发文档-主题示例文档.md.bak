<%= if (bannerTitle) { %>
<section class="page-banner" style="background-image: url('<%= bannerImage || asset_path('images/banner-default.jpg') %>');">
  <div class="banner-overlay"></div>
  <div class="container">
    <div class="banner-content">
      <h1 class="banner-title"><%= bannerTitle %></h1>

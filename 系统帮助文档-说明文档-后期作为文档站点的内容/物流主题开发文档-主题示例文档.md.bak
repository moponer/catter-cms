### 4.7 联系我们页 (contact.plush.html)

```html
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <title>联系我们 - <%= site['title'] %></title>
  <%= partial("head.html") { %>
    <meta name="description" content="联系速达物流，获取专业物流解决方案">
  <% } %>
</head>
<body>
  <%= partial("header.html") {} %>
  
  <%= partial("banner.html") {
    bannerTitle: "联系我们",
    bannerSubtitle: "期待与您的合作，为您提供专业物流服务",
    bannerImage: asset_path("images/banner-contact.jpg"),
    breadcrumbs: [
      { Label: "联系我们" }
    ]
  } %>
  
  <main class="contact-page">
    <!-- 联系信息卡片 -->
    <section class="contact-info-section">
      <div class="container">
        <div class="info-cards">
          <div class="info-card">
            <div class="info-icon">
              <img src="<%= asset_path('images/icons/icon-phone-large.svg') %>" alt="电话">
            </div>
            <h3>客服热线</h3>
            <p class="info-value"><%= config['contact.phone'] || '400-888-8888' %></p>
            <p class="info-desc">7×24小时服务热线</p>
          </div>
          <div class="info-card">
            <div class="info-icon">
              <img src="<%= asset_path('images/icons/icon-email-large.svg') %>" alt="邮箱">
            </div>
            <h3>电子邮箱</h3>
            <p class="info-value"><%= config['contact.email'] || 'service@speedlogistics.com' %></p>
            <p class="info-desc">工作日24小时内回复</p>
          </div>
          <div class="info-card">
            <div class="info-icon">
              <img src="<%= asset_path('images/icons/icon-location-large.svg') %>" alt="地址">
            </div>
            <h3>公司地址</h3>
            <p class="info-value"><%= config['contact.address'] || '北京市朝阳区物流园区88号' %></p>
            <p class="info-desc">欢迎来访考察</p>
          </div>
          <div class="info-card">
            <div class="info-icon">
              <img src="<%= asset_path('images/icons/icon-clock-large.svg') %>" alt="时间">
            </div>
            <h3>工作时间</h3>
            <p class="info-value"><%= config['contact.worktime'] || '周一至周日' %></p>
            <p class="info-desc">全年无休为您服务</p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- 联系表单和地图 -->
    <section class="contact-main section-padding bg-light">
      <div class="container">
        <div class="contact-layout">
          <!-- 表单 -->
          <div class="contact-form-wrapper">
            <h2 class="section-title">在线咨询</h2>
            <p class="form-desc">填写以下信息，我们将尽快与您联系</p>
            
            <form class="contact-form" action="/api/contact" method="POST">
              <div class="form-row">
                <div class="form-group">
                  <label for="name">您的姓名 <span class="required">*</span></label>
                  <input type="text" id="name" name="name" required placeholder="请输入姓名">
                </div>
                <div class="form-group">
                  <label for="phone">联系电话 <span class="required">*</span></label>
                  <input type="tel" id="phone" name="phone" required placeholder="请输入电话">
                </div>
              </div>
              
              <div class="form-row">
                <div class="form-group">
                  <label for="company">公司名称</label>
                  <input type="text" id="company" name="company" placeholder="请输入公司名称">
                </div>
                <div class="form-group">
                  <label for="service">咨询业务</label>
                  <select id="service" name="service">
                    <option value="">请选择业务类型</option>
                    <option value="express">快递服务</option>
                    <option value="freight">货运服务</option>
                    <option value="warehouse">仓储服务</option>
                    <option value="coldchain">冷链物流</option>
                    <option value="supplychain">供应链服务</option>
                    <option value="other">其他业务</option>
                  </select>
                </div>
              </div>
              
              <div class="form-group">
                <label for="content">咨询内容 <span class="required">*</span></label>
                <textarea id="content" name="content" rows="5" required placeholder="请描述您的物流需求..."></textarea>
              </div>
              
              <button type="submit" class="btn btn-primary btn-lg btn-block">提交咨询</button>
            </form>
          </div>
          
          <!-- 地图 -->
          <div class="contact-map-wrapper">
            <%= if (config['contact.map']) { %>
              <div class="map-container">
                <%= raw(config['contact.map']) %>
              </div>
            <%= } else { %>
              <div class="map-placeholder">
                <img src="<%= asset_path('images/map-placeholder.jpg') %>" alt="公司位置">
                <div class="map-overlay">
                  <p>请在后台配置地图嵌入代码</p>
                </div>
              </div>
            <%= } %>
          </div>
        </div>
      </div>
    </section>
    
    <!-- 常见问题 -->
    <section class="contact-faq section-padding">
      <div class="container">
        <div class="section-header text-center">
          <h2 class="section-title">常见问题</h2>
          <p class="section-subtitle">快速找到您想要的答案</p>
        </div>
        
        <div class="faq-list">
          <%= for (faq, index) in faqs { %>
          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              <span class="faq-number"><%= index + 1 %></span>
              <span class="faq-text"><%= faq.Question %></span>
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-answer">
              <p><%= faq.Answer %></p>
            </div>
          </div>
          <%= } %>
        </div>
      </div>
    </section>
  </main>
  
  <%= partial("footer.html") {} %>
  <%= partial("scripts.html") {} %>
</body>
</html>
```


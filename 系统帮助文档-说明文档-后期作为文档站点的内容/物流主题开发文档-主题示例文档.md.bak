## 四、页面模板开发

### 4.1 公共组件

#### partials/head.plush.html

```html
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="<%= metaDescription || site['description'] %>">
<meta name="keywords" content="<%= join(config['seo.keywords'] || [], ',') %>">
<meta name="author" content="<%= config['seo.author'] || '速达物流' %>">

<!-- Open Graph -->
<meta property="og:title" content="<%= pageTitle || site['title'] %>">
<meta property="og:description" content="<%= metaDescription || site['description'] %>">
<meta property="og:type" content="website">
<meta property="og:image" content="<%= config['seo.ogImage'] || asset_path('images/banner-home.jpg') %>">

<!-- Favicon -->
<%= if (config['site.favicon']) { %>
<link rel="icon" href="<%= config['site.favicon'] %>">
<%= } else { %>
<link rel="icon" href="<%= asset_path('images/favicon.ico') %>">
<%= } %>

<!-- Styles -->
<link rel="stylesheet" href="<%= asset_path('css/main.css') %>">
<link rel="stylesheet" href="<%= asset_path('css/components.css') %>">
<link rel="stylesheet" href="<%= asset_path('css/responsive.css') %>">

<!-- Custom CSS -->
<%= if (config['custom.css']) { %>
<style>
<%= config['custom.css'] %>
</style>
<%= } %>
```

#### partials/header.plush.html

```html
<header class="site-header">
  <div class="header-top">
    <div class="container">
      <div class="header-contact">
        <span><i class="icon-phone"></i> 客服热线：<%= config['contact.phone'] || '400-888-8888' %></span>
        <span><i class="icon-clock"></i> <%= config['contact.worktime'] || '周一至周日 8:00-20:00' %></span>
      </div>
    </div>
  </div>
  
  <nav class="main-nav">
    <div class="container">
      <a href="/" class="logo">
        <%= if (config['site.logo']) { %>
          <img src="<%= config['site.logo'] %>" alt="<%= config['site.title'] || '速达物流' %>">
        <%= } else { %>
          <span class="logo-text">速达<span class="highlight">物流</span></span>
        <%= } %>
      </a>
      
      <button class="mobile-menu-toggle" aria-label="菜单">
        <span></span>
        <span></span>
        <span></span>
      </button>
      
      <ul class="nav-menu">
        <%= for (item) in menus['header'] { %>
          <li class="nav-item <%= if (item.Children && len(item.Children) > 0) { 'has-dropdown' } %>">
            <a href="<%= item.URL %>" class="nav-link <%= if (item.Active) { 'active' } %>">
              <%= item.Label %>
            </a>
            <%= if (item.Children && len(item.Children) > 0) { %>
              <ul class="dropdown-menu">
                <%= for (child) in item.Children { %>
                  <li><a href="<%= child.URL %>"><%= child.Label %></a></li>
                <%= } %>
              </ul>
            <%= } %>
          </li>
        <%= } %>
      </ul>
      
      <a href="/contact" class="btn btn-primary nav-cta">立即下单</a>
    </div>
  </nav>
</header>
```

#### partials/footer.plush.html

```html
<footer class="site-footer">
  <div class="footer-main">
    <div class="container">
      <div class="footer-grid">
        <!-- 公司信息 -->
        <div class="footer-about">
          <h4 class="footer-title">关于速达</h4>
          <p class="footer-desc"><%= config['footer.about'] || '速达物流是一家专业的综合物流服务提供商。' %></p>
          <div class="footer-contact">
            <p><i class="icon-phone"></i> <%= config['contact.phone'] || '400-888-8888' %></p>
            <p><i class="icon-email"></i> <%= config['contact.email'] || 'service@speedlogistics.com' %></p>
            <p><i class="icon-location"></i> <%= config['contact.address'] || '北京市朝阳区物流园区88号' %></p>
          </div>
        </div>
        
        <!-- 快速链接 -->
        <div class="footer-links">
          <h4 class="footer-title">快速链接</h4>
          <ul>
            <%= for (item) in menus['footer'] { %>
              <li><a href="<%= item.URL %>"><%= item.Label %></a></li>
            <%= } %>
          </ul>
        </div>
        
        <!-- 服务项目 -->
        <div class="footer-services">
          <h4 class="footer-title">服务项目</h4>
          <ul>
            <li><a href="/service/express">快递服务</a></li>
            <li><a href="/service/freight">货运服务</a></li>
            <li><a href="/service/warehouse">仓储服务</a></li>
            <li><a href="/service/coldchain">冷链物流</a></li>
          </ul>
        </div>
        
        <!-- 关注我们 -->
        <div class="footer-social">
          <h4 class="footer-title">关注我们</h4>
          <p>扫码关注公众号，获取最新物流资讯</p>
          <div class="qr-code">
            <img src="<%= asset_path('images/qr-code.png') %>" alt="公众号二维码">
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="footer-bottom">
    <div class="container">
      <p class="copyright"><%= config['footer.copyright'] || '© 2024 速达物流 版权所有' %></p>
      <%= if (config['footer.icp']) { %>
        <p class="icp"><a href="https://beian.miit.gov.cn" target="_blank"><%= config['footer.icp'] %></a></p>
      <%= } %>
      <%= if (config['footer.showLinks'] && config['footer.links']) { %>
        <div class="friend-links">
          <span>友情链接：</span>
          <%= let links = json_decode(config['footer.links']) || [] %>
          <%= for (link, index) in links { %>
            <a href="<%= link.url %>" target="_blank"><%= link.name %></a>
            <%= if (index < len(links) - 1) { %> | <% } %>
          <%= } %>
        </div>
      <%= } %>
    </div>
  </div>
</footer>
```

#### partials/banner.plush.html


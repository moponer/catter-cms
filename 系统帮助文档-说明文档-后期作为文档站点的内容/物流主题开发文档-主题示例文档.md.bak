### 4.2 首页 (home.plush.html)

```html
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <title><%= site['title'] %></title>
  <%= partial("head.html") { %>
    <meta name="description" content="<%= site['description'] %>">
  <% } %>
</head>
<body>
  <%= partial("header.html") {} %>
  
  <main class="home-page">
    <!-- Hero Section -->
    <%= if (config['home.hero.enabled'] != false) { %>
    <section class="hero-section" style="background-image: url('<%= config['home.hero.background'] || asset_path('images/banner-home.jpg') %>');">
      <div class="hero-overlay"></div>
      <div class="container">
        <div class="hero-content">
          <h1 class="hero-title"><%= config['home.hero.title'] || '让物流更简单' %></h1>
          <p class="hero-subtitle"><%= config['home.hero.subtitle'] || '覆盖全国300+城市，日均处理订单100万+' %></p>
          <div class="hero-actions">
            <a href="<%= config['home.hero.ctaUrl'] || '/contact' %>" class="btn btn-lg btn-accent">
              <%= config['home.hero.ctaText'] || '立即咨询' %>
            </a>
            <a href="<%= config['home.hero.secondaryCtaUrl'] || '/services' %>" class="btn btn-lg btn-outline-white">
              <%= config['home.hero.secondaryCtaText'] || '了解服务' %>
            </a>
          </div>
        </div>
      </div>
    </section>
    <%= } %>
    
    <!-- 服务特色 -->
    <section class="features-section">
      <div class="container">
        <div class="features-grid">
          <div class="feature-item">
            <div class="feature-icon">
              <img src="<%= asset_path('images/icons/icon-fast.svg') %>" alt="快速">
            </div>
            <h3>时效保障</h3>
            <p>精准时效承诺，超时赔付</p>
          </div>
          <div class="feature-item">
            <div class="feature-icon">
              <img src="<%= asset_path('images/icons/icon-safe.svg') %>" alt="安全">
            </div>
            <h3>安全可靠</h3>
            <p>全程GPS跟踪，货物保险</p>
          </div>
          <div class="feature-item">
            <div class="feature-icon">
              <img src="<%= asset_path('images/icons/icon-price.svg') %>" alt="价格">
            </div>
            <h3>价格透明</h3>
            <p>明码标价，无隐形费用</p>
          </div>
          <div class="feature-item">
            <div class="feature-icon">
              <img src="<%= asset_path('images/icons/icon-service.svg') %>" alt="服务">
            </div>
            <h3>专业服务</h3>
            <p>7×24小时客服支持</p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- 服务项目 -->
    <%= if (config['home.services.enabled'] != false) { %>
    <section class="services-section section-padding">
      <div class="container">
        <div class="section-header text-center">
          <h2 class="section-title"><%= config['home.services.title'] || '我们的服务' %></h2>
          <p class="section-subtitle"><%= config['home.services.subtitle'] || '全方位物流解决方案' %></p>
        </div>
        
        <div class="services-grid">
          <%= let serviceCount = config['home.services.count'] || 6 %>
          <%= let displayServices = services || [] %>
          <%= for (service, index) in displayServices { %>
            <%= if (index < serviceCount) { %>
            <div class="service-card">
              <div class="service-image">
                <img src="<%= service.Image || asset_path('images/service-default.jpg') %>" alt="<%= service.Title %>">
              </div>
              <div class="service-content">
                <h3><a href="/service/<%= service.Slug %>"><%= service.Title %></a></h3>
                <p><%= service.Summary %></p>
                <a href="/service/<%= service.Slug %>" class="link-arrow">了解详情 →</a>
              </div>
            </div>
            <%= } %>
          <%= } %>
        </div>
        
        <div class="text-center mt-5">
          <a href="/services" class="btn btn-primary btn-lg">查看全部服务</a>
        </div>
      </div>
    </section>
    <%= } %>
    
    <!-- 数据统计 -->
    <%= if (config['home.stats.enabled'] != false) { %>
    <section class="stats-section section-padding bg-dark">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-item">
            <div class="stat-number" data-count="<%= config['home.stats.years'] || 15 %>">0</div>
            <div class="stat-label">年行业经验</div>
          </div>
          <div class="stat-item">
            <div class="stat-number" data-count="<%= config['home.stats.cities'] || 300 %>">0</div>
            <div class="stat-label">覆盖城市</div>
          </div>
          <div class="stat-item">
            <div class="stat-number" data-count="<%= config['home.stats.vehicles'] || 5000 %>">0</div>
            <div class="stat-label">运输车辆</div>
          </div>
          <div class="stat-item">
            <div class="stat-number" data-count="<%= config['home.stats.employees'] || 8000 %>">0</div>
            <div class="stat-label">专业员工</div>
          </div>
        </div>
      </div>
    </section>
    <%= } %>
    
    <!-- 行业新闻 -->
    <%= if (config['home.news.enabled'] != false) { %>
    <section class="news-section section-padding">
      <div class="container">
        <div class="section-header text-center">
          <h2 class="section-title"><%= config['home.news.title'] || '行业动态' %></h2>
          <p class="section-subtitle"><%= config['home.news.subtitle'] || '了解物流行业最新资讯' %></p>
        </div>
        
        <div class="news-grid">
          <%= let newsCount = config['home.news.count'] || 4 %>
          <%= let displayNews = news || [] %>
          <%= for (item, index) in displayNews { %>
            <%= if (index < newsCount) { %>
            <article class="news-card">
              <div class="news-image">
                <img src="<%= item.Thumbnail || asset_path('images/news-default.jpg') %>" alt="<%= item.Title %>">
                <span class="news-date">
                  <span class="day"><%= format_date(item.PublishedAt, '02') %></span>
                  <span class="month"><%= format_date(item.PublishedAt, '01') %>月</span>
                </span>
              </div>
              <div class="news-content">
                <h3><a href="/news/<%= item.Slug %>"><%= item.Title %></a></h3>
                <p><%= item.Excerpt %></p>
                <a href="/news/<%= item.Slug %>" class="link-arrow">阅读全文 →</a>
              </div>
            </article>
            <%= } %>
          <%= } %>
        </div>
        
        <div class="text-center mt-5">
          <a href="/news" class="btn btn-outline-primary btn-lg">查看更多新闻</a>
        </div>
      </div>
    </section>
    <%= } %>
    
    <!-- CTA区域 -->
    <section class="cta-section section-padding bg-primary">
      <div class="container">
        <div class="cta-content text-center">
          <h2>需要物流服务？</h2>
          <p>立即联系我们，获取专属物流解决方案</p>
          <a href="/contact" class="btn btn-lg btn-accent">免费咨询</a>
        </div>
      </div>
    </section>
  </main>
  
  <%= partial("footer.html") {} %>
  <%= partial("scripts.html") {} %>
</body>
</html>
```


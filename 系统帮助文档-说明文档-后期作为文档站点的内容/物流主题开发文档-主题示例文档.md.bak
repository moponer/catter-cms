## 三、theme.yml 完整配置

创建文件：`speedlogistics/theme.yml`

```yaml
# ========================================
# 速达物流主题配置文件
# ========================================

# 基础信息
name: "速达物流"
slug: "speedlogistics"
version: "1.0.0"
apiVersion: "2.0"
description: "专业的物流企业官网主题，适用于快递、货运、仓储、冷链等物流服务企业"
author: "Catter Team"
authorEmail: "support@cattercms.com"
license: "MIT"
tags: ["物流", "企业", "货运", "仓储", "B2B"]

# 预览图
screenshots:
  - "screenshots/screenshot-home.jpg"
  - "screenshots/screenshot-services.jpg"
  - "screenshots/screenshot-news.jpg"
thumbnail: "screenshots/thumbnail.png"

# 主题能力
capabilities:
  layouts:
    - default
    - fullwidth
    - landing
  modules:
    - hero
    - services
    - news
    - fleet
    - stats
    - cta
    - testimonials
    - partners
  customFields: true

# ========================================
# 配置定义（后台配置表单）
# ========================================
configDefinition:

  # 基础信息
  - section: "基础信息"
    icon: "info"
    description: "配置网站的基本信息"
    fields:
      - name: "site.title"
        label: "网站标题"
        type: "text"
        default: "速达物流 - 专业物流服务提供商"
        required: true
      
      - name: "site.subtitle"
        label: "网站副标题"
        type: "text"
        default: "安全、高效、专业的物流解决方案"
      
      - name: "site.description"
        label: "网站描述"
        type: "textarea"
        rows: 3
        default: "速达物流是一家专业的综合物流服务提供商，提供快递、货运、仓储、冷链等全方位物流服务。"
      
      - name: "site.logo"
        label: "网站Logo"
        type: "image"
        description: "建议尺寸 200x60px，透明背景PNG格式"
      
      - name: "site.favicon"
        label: "网站图标"
        type: "image"
        description: "建议尺寸 32x32px，ICO格式"

  # 联系方式
  - section: "联系方式"
    icon: "phone"
    description: "配置公司的联系信息，会显示在网站各处"
    fields:
      - name: "contact.phone"
        label: "客服电话"
        type: "text"
        default: "400-888-8888"
        required: true
      
      - name: "contact.hotline"
        label: "业务热线"
        type: "text"
        default: "400-999-9999"
      
      - name: "contact.email"
        label: "电子邮箱"
        type: "text"
        default: "service@speedlogistics.com"
      
      - name: "contact.address"
        label: "公司地址"
        type: "textarea"
        rows: 2
        default: "北京市朝阳区物流园区88号"
      
      - name: "contact.worktime"
        label: "工作时间"
        type: "text"
        default: "周一至周日 8:00-20:00"
      
      - name: "contact.map"
        label: "地图嵌入代码"
        type: "code"
        language: "html"
        rows: 5
        description: "百度地图或高德地图的嵌入代码"

  # 品牌色彩
  - section: "品牌色彩"
    icon: "palette"
    description: "自定义主题颜色"
    fields:
      - name: "colors.primary"
        label: "主色调"
        type: "color"
        default: "#1e3a5f"
        description: "品牌主色，用于导航、按钮等"
      
      - name: "colors.accent"
        label: "强调色"
        type: "color"
        default: "#f97316"
        description: "CTA按钮、高亮元素"
      
      - name: "colors.text"
        label: "文字颜色"
        type: "color"
        default: "#1f2937"
      
      - name: "colors.background"
        label: "背景颜色"
        type: "color"
        default: "#ffffff"

  # 首页配置
  - section: "首页配置"
    icon: "home"
    description: "配置首页各模块的显示内容"
    fields:
      # Hero区域
      - name: "home.hero.enabled"
        label: "启用Hero区域"
        type: "switch"
        default: true
      
      - name: "home.hero.title"
        label: "Hero主标题"
        type: "text"
        default: "让物流更简单"
        show_if: "home.hero.enabled"
      
      - name: "home.hero.subtitle"
        label: "Hero副标题"
        type: "textarea"
        rows: 2
        default: "覆盖全国300+城市，日均处理订单100万+，为您提供安全、高效、专业的物流解决方案"
        show_if: "home.hero.enabled"
      
      - name: "home.hero.background"
        label: "Hero背景图片"
        type: "image"
        description: "建议尺寸 1920x600px"
        show_if: "home.hero.enabled"
      
      - name: "home.hero.ctaText"
        label: "主按钮文字"
        type: "text"
        default: "立即咨询"
        show_if: "home.hero.enabled"
      
      - name: "home.hero.ctaUrl"
        label: "主按钮链接"
        type: "text"
        default: "/contact"
        show_if: "home.hero.enabled"
      
      - name: "home.hero.secondaryCtaText"
        label: "次要按钮文字"
        type: "text"
        default: "了解服务"
        show_if: "home.hero.enabled"
      
      - name: "home.hero.secondaryCtaUrl"
        label: "次要按钮链接"
        type: "text"
        default: "/services"
        show_if: "home.hero.enabled"
      
      # 服务模块
      - name: "home.services.enabled"
        label: "启用服务展示"
        type: "switch"
        default: true
      
      - name: "home.services.title"
        label: "服务模块标题"
        type: "text"
        default: "我们的服务"
        show_if: "home.services.enabled"
      
      - name: "home.services.subtitle"
        label: "服务模块副标题"
        type: "text"
        default: "全方位物流解决方案，满足您的各种需求"
        show_if: "home.services.enabled"
      
      - name: "home.services.count"
        label: "显示服务数量"
        type: "number"
        default: 6
        min: 3
        max: 12
        show_if: "home.services.enabled"
      
      # 数据统计
      - name: "home.stats.enabled"
        label: "启用数据统计"
        type: "switch"
        default: true
      
      - name: "home.stats.years"
        label: "成立年限"
        type: "number"
        default: 15
        show_if: "home.stats.enabled"
      
      - name: "home.stats.cities"
        label: "覆盖城市"
        type: "number"
        default: 300
        show_if: "home.stats.enabled"
      
      - name: "home.stats.vehicles"
        label: "运输车辆"
        type: "number"
        default: 5000
        show_if: "home.stats.enabled"
      
      - name: "home.stats.employees"
        label: "员工人数"
        type: "number"
        default: 8000
        show_if: "home.stats.enabled"
      
      # 新闻模块
      - name: "home.news.enabled"
        label: "启用新闻展示"
        type: "switch"
        default: true
      
      - name: "home.news.title"
        label: "新闻模块标题"
        type: "text"
        default: "行业动态"
        show_if: "home.news.enabled"
      
      - name: "home.news.subtitle"
        label: "新闻模块副标题"
        type: "text"
        default: "了解物流行业最新资讯"
        show_if: "home.news.enabled"
      
      - name: "home.news.count"
        label: "显示新闻数量"
        type: "number"
        default: 4
        min: 2
        max: 8
        show_if: "home.news.enabled"

  # 页脚配置
  - section: "页脚配置"
    icon: "footer"
    description: "配置页脚内容"
    fields:
      - name: "footer.about"
        label: "公司简介"
        type: "textarea"
        rows: 4
        default: "速达物流成立于2009年，是一家专业的综合物流服务提供商。我们致力于为客户提供安全、高效、便捷的物流解决方案。"
      
      - name: "footer.copyright"
        label: "版权信息"
        type: "text"
        default: "© 2024 速达物流 版权所有"
      
      - name: "footer.icp"
        label: "ICP备案号"
        type: "text"
        default: "京ICP备12345678号"
      
      - name: "footer.showLinks"
        label: "显示友情链接"
        type: "switch"
        default: true
      
      - name: "footer.links"
        label: "友情链接"
        type: "code"
        language: "json"
        rows: 10
        default: |
          [
            {"name": "中国物流协会", "url": "http://www.chinawuliu.com"},
            {"name": "交通运输部", "url": "http://www.mot.gov.cn"}
          ]
        show_if: "footer.showLinks"

  # SEO配置
  - section: "SEO设置"
    icon: "search"
    description: "搜索引擎优化设置"
    fields:
      - name: "seo.keywords"
        label: "网站关键词"
        type: "tags"
        default: ["物流", "快递", "货运", "仓储", "冷链", "供应链"]
      
      - name: "seo.author"
        label: "网站作者"
        type: "text"
        default: "速达物流"
      
      - name: "seo.ogImage"
        label: "Open Graph图片"
        type: "image"
        description: "社交媒体分享时显示的图片，建议尺寸 1200x630px"

  # 自定义代码
  - section: "自定义代码"
    icon: "code"
    description: "添加自定义CSS和JavaScript"
    fields:
      - name: "custom.css"
        label: "自定义CSS"
        type: "code"
        language: "css"
        rows: 15
        description: "会覆盖主题的默认样式"
      
      - name: "custom.js"
        label: "自定义JavaScript"
        type: "code"
        language: "javascript"
        rows: 15
        description: "在页面底部加载"

# 菜单位置
menuLocations:
  header:
    name: "顶部导航"
    description: "网站顶部主导航菜单"
    maxDepth: 2
  footer:
    name: "底部导航"
    description: "网站底部导航菜单"
    maxDepth: 1

# 默认菜单
menus:
  header:
    - label: "首页"
      url: "/"
      icon: "home"
      enabled: true
    - label: "服务项目"
      url: "/services"
      icon: "truck"
      enabled: true
      children:
        - label: "快递服务"
          url: "/service/express"
          icon: "package"
        - label: "货运服务"
          url: "/service/freight"
          icon: "truck"
        - label: "仓储服务"
          url: "/service/warehouse"
          icon: "warehouse"
        - label: "冷链物流"
          url: "/service/coldchain"
          icon: "snowflake"
    - label: "行业新闻"
      url: "/news"
      icon: "newspaper"
      enabled: true
    - label: "运力展示"
      url: "/fleet"
      icon: "truck-moving"
      enabled: true
    - label: "关于我们"
      url: "/about"
      icon: "building"
      enabled: true
    - label: "联系我们"
      url: "/contact"
      icon: "phone"
      enabled: true

  footer:
    - label: "服务项目"
      url: "/services"
      enabled: true
    - label: "行业新闻"
      url: "/news"
      enabled: true
    - label: "运力展示"
      url: "/fleet"
      enabled: true
    - label: "关于我们"
      url: "/about"
      enabled: true
    - label: "联系我们"
      url: "/contact"
      enabled: true
```

